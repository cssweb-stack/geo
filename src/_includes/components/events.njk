<div class="grid-compact grid-spaced">
{% for lecture in events %}
{% set date = lecture.date | eventDate %}
<div class="event-date-box tile-style tile-blue" aria-hidden="true">
<img class="event-calendar-icon" src="{{ '/assets/icons/calendar3-white.svg' | url }}" alt="">
<span class="event-compact-date">{{ date.compact | escape }}</span>
</div>
<section aria-labelledby="event-title-{{ loop.index }}">
<h2 id="event-title-{{ loop.index }}">{{ lecture.title | escape }}</h2>
<ul>
{% if lecture.speaker %}<li class="lecture-speaker">{{ lecture.speaker | escape }}</li>{% endif %}
{% if lecture.affiliation %}<li>{{ lecture.affiliation | escape }}</li>{% endif %}
<li><time datetime="{{ date.iso | escape }}">{{ date.full | escape }}</time></li>
</ul>
</section>
{% endfor %}
</div>
