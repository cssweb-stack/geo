<nav class="unit-nav navbar navbar-expand-lg p-0" aria-label="Department navigation">
    <div class="container">
        <div class="collapse navbar-collapse" id="unitNavigation">
            <ul class="navbar-nav w-100 justify-content-between">
                {% for item in navigation %}
                    {% if item.children %}
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle nav-trigger"
                                    type="button"
                                    id="navItem{{ loop.index }}"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">{{ item.label }}</button>
                            <ul class="dropdown-menu" aria-labelledby="navItem{{ loop.index }}">
                                {% for child in item.children %}
                                    <li>
                                        <a class="dropdown-item" href="{{ child.url | url }}">
                                            {% if child.icon == 'people' %}
                                                <svg class="nav-menu-icon" width="18" height="18" viewBox="0 0 24 24"
                                                     fill="none" stroke="currentColor" stroke-width="1.8"
                                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                                    <circle cx="9" cy="7" r="4"/>
                                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                                                </svg>
                                            {% endif %}
                                            <span>{{ child.label }}</span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ item.url | url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
    </div>
</nav>
