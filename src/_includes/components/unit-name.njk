<div class="unit-name"><div class="container py-3">
  <div class="d-flex align-items-center justify-content-between gap-2">
    <a href="{{ "/" | url }}" class="unit-name-link">{{ site.name }}</a>
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
      <form class="desktop-search d-none d-lg-flex" role="search" action="https://www.google.com/search" method="get">
        <label class="visually-hidden" for="unit-search-desktop">Search Geography website</label>
        <input id="unit-search-desktop" class="form-control form-control-sm" type="search" name="q" placeholder="Search GEO" required>
        <input type="hidden" name="sitesearch" value="geography.manoa.hawaii.edu">
        <button class="btn btn-outline-secondary btn-sm ms-1" type="submit" aria-label="Search Geography website"><span aria-hidden="true">⌕</span></button>
      </form>
      <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileSearch" aria-controls="mobileSearch" aria-expanded="false" aria-label="Toggle site search"><span aria-hidden="true">⌕</span></button>
      <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#unitNavigation" aria-controls="unitNavigation" aria-expanded="false" aria-label="Toggle department navigation"><span aria-hidden="true">☰</span></button>
    </div>
  </div>
  <div class="collapse mt-3" id="mobileSearch"><form role="search" action="https://www.google.com/search" method="get" class="d-flex gap-2">
    <label class="visually-hidden" for="unit-search-mobile">Search Geography website</label>
    <input id="unit-search-mobile" class="form-control" type="search" name="q" placeholder="Search GEO" required>
    <input type="hidden" name="sitesearch" value="geography.manoa.hawaii.edu">
    <button class="btn btn-outline-secondary" type="submit">Search</button>
  </form></div>
</div></div>
