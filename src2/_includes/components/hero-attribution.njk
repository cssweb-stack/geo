{# Full-width imagery credit immediately above the footer. #}
{% set assignedHero = heroes.pages[page.url] %}
{% if not assignedHero %}{% set assignedHero = faculty_heroes.pages[page.url] %}{% endif %}
{% if assignedHero %}
<aside class="hero-attribution" aria-label="Imagery attribution">
<div class="container hero-attribution-inner">
<p><span class="hero-attribution-label">Imagery:</span> <a href="{{ heroes.credit.url }}">{{ heroes.credit.source | escape }}</a></p>
</div>
</aside>
{% endif %}
