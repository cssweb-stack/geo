<div class="unit-name"><div class="container unit-name-inner">
<div class="unit-name-row">
<a href="{{ "/" | url }}" class="unit-name-link">{{ site.name }}</a>
<div class="unit-actions">
<form class="desktop-search" role="search" action="https://www.google.com/search" method="get">
<label class="visually-hidden" for="unit-search-desktop">Search Geography website</label>
<input id="unit-search-desktop" class="form-control form-control-sm" type="search" name="q" placeholder="Search GEO" required>
<input type="hidden" name="sitesearch" value="geography.manoa.hawaii.edu">
<button class="btn btn-outline-secondary desktop-search-submit" type="submit" aria-label="Search Geography website">{% include "icons/search.svg" %}</button>
</form>
<button class="unit-icon-button unit-search-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mobileSearch" aria-controls="mobileSearch" aria-expanded="false" aria-label="Toggle site search">{% include "icons/search.svg" %}</button>
<button class="unit-icon-button unit-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#unitNavigation" aria-controls="unitNavigation" aria-expanded="false" aria-label="Toggle department navigation">{% include "icons/list.svg" %}</button>
</div>
</div>
<div class="collapse mobile-search" id="mobileSearch"><form role="search" action="https://www.google.com/search" method="get" class="mobile-search-form">
<label class="visually-hidden" for="unit-search-mobile">Search Geography website</label>
<input id="unit-search-mobile" class="form-control" type="search" name="q" placeholder="Search GEO" required>
<input type="hidden" name="sitesearch" value="geography.manoa.hawaii.edu">
<button class="btn btn-outline-secondary" type="submit">Search</button>
</form></div>
</div></div>
